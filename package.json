{
  "name": "900words-self-hosted",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-clue-lexicon.mjs --check && node scripts/generate-deal-index.mjs --check && vite build && node scripts/validate-client-boundary.mjs && node scripts/validate-release-package.mjs dist",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:words": "node scripts/validate-words.mjs",
    "render:grammar": "node scripts/render-grammar-doc.mjs",
    "validate:grammar": "node scripts/validate-grammar.mjs",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "render:examples": "node scripts/render-example-curriculum.mjs",
    "validate:examples": "node scripts/render-example-curriculum.mjs --check && node scripts/validate-examples.mjs",
    "validate:audio": "node scripts/validate-audio.mjs",
    "validate:review-sentences": "node scripts/german-city1-review.mjs --check && node scripts/danish-city1-review-upgrade.mjs --check",
    "validate:audio-acoustics": "node scripts/validate-audio-acoustics.mjs",
    "validate:ui-sfx": "node scripts/validate-ui-sfx.mjs",
    "validate:matrix": "node scripts/validate-matrix.mjs",
    "validate:book": "node scripts/validate-book.mjs",
    "validate:client-boundary": "node scripts/validate-client-boundary.mjs",
    "validate:release-package": "node scripts/validate-release-package.mjs",
    "validate:clue-lexicon": "node scripts/generate-clue-lexicon.mjs --check",
    "validate:deal-index": "node scripts/generate-deal-index.mjs --check",
    "validate:legal-index-clues": "node scripts/generate-legal-index-clues.mjs --check",
    "drives": "node scripts/run-drives.mjs",
    "verify": "npm run typecheck && npm run validate:literals && npm run test && npm run validate:words && npm run validate:grammar && npm run validate:curriculum && npm run validate:examples && npm run validate:audio && npm run validate:review-sentences && npm run validate:audio-acoustics && npm run validate:ui-sfx && npm run validate:board-set && npm run validate:german-course && npm run validate:coverage-claims && npm run validate:matrix && npm run validate:book && npm run validate:clue-lexicon && npm run validate:legal-index-clues && npm run drives",
    "validate:board-set": "node scripts/select-city1-board-set-v2.mjs --check",
    "validate:german-course": "node scripts/german-city1-course.mjs --check",
    "validate:coverage-claims": "node scripts/validate-coverage-claims.mjs",
    "measure:spoken-coverage": "node scripts/measure-spoken-coverage.mjs",
    "measure:shipped-coverage": "node scripts/measure-shipped-coverage.mjs",
    "validate:literals": "node scripts/validate-literals.mjs",
    "build:web-demo": "node scripts/build-web-demo.mjs",
    "ios": "CAP_BUILD=1 npm run build && npx cap sync ios && npx cap open ios",
    "android": "CAP_BUILD=1 npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@litert-lm/core": "0.17.1",
    "cluecab-gemma": "file:./ios-plugins/cluecab-gemma",
    "cluecab-keyboard": "file:./ios-plugins/cluecab-keyboard",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "4.130.0"
  },
  "license": "MPL-2.0",
  "description": "900words, built yourself: a Danish vocabulary game with Casey, on your iPhone, your Android phone or in your browser."
}
