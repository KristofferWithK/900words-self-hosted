{
  "language": "da",
  "city": 0,
  "cityName": "Sønderborg",
  "status": "draft: every name needs a Danish speaker check",
  "about": [
    "100 default café names for Sønderborg (docs/roadmap/cafe-world.md section 5). Not assigned to boards; that is CW-08's job.",
    "Every content word is a course word: a card word (wordId; courseCity is the city that teaches it, 1 = Sønderborg) or one of Sønderborg's connecting words (src/data/city1-connecting-words.da.json) or a ledger form the course teaches later (ved, under, og). \"Café\" itself is the frame, not a course word.",
    "Capitals: every word of a name is capitalised except og, ved, i and under. A Danish speaker should confirm the style as well as the grammar.",
    "signatureItem is the one item drawn from the name that lies on the café table (contract section 5). It is a suggestion in English for the artist, not player copy."
  ],
  "forms": {
    "definite": "Café + one course word in its \"the\" form: -en for an en-word, -et for an et-word.",
    "definite-plural": "Café + a course word in its plural \"the\" form (-ne, -ene, -erne).",
    "adjective-definite": "den (en-word) or det (et-word) + the adjective with -e + the noun, as in \"Den Røde Dør\".",
    "genitive": "Someone's place: the owner with -s, then the thing, as in \"Mors Køkken\".",
    "pair": "Two course words joined by og.",
    "compound": "One compound word in its \"the\" form, as in \"Kaffehuset\" or \"Strandcaféen\".",
    "place": "A noun with ved, i or under, as in \"Huset ved Havet\".",
    "phrase": "An everyday phrase built from Sønderborg's connecting words."
  },
