      "sourceHash": "f8a05f32f1d956bb5b6f935822592593376e46f1438f0dead4152689a8bd67fb"
    },
    "kobenhavn-a2-interaction-b-audio-1": {
      "id": "kobenhavn-a2-interaction-b-audio-1",
      "text": "Din aftale er fredag. Hvornår kan du hente pakken i stedet?",
      "stamp": "87589b9f05a29227",
      "bytes": 23232,
      "at": "2026-08-23T00:08:15.581Z",
      "sourceHash": "f97e4d672ad850035bf81ccbf611e355fdb5c7ccd915c190a41f63e3c10fbeca"
    },
    "kobenhavn-a2-interaction-b-audio-2": {
      "id": "kobenhavn-a2-interaction-b-audio-2",
      "text": "Kan du komme klokken sytten?",
      "stamp": "97aaf815096bd788",
      "bytes": 6144,
      "at": "2026-08-23T00:08:16.058Z",
      "sourceHash": "fc7b1a5910eab2f1ab13c024bac329ecf638c3e566c789d8b8f3accf0c17e2c1"
    },
    "kobenhavn-a2-writing-a-audio-1": {
      "id": "kobenhavn-a2-writing-a-audio-1",
      "text": "Skriv, hvad der skete, og hvad du gør bagefter.",
