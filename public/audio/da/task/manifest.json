    "kobenhavn-a2-listening-a-audio-1": {
      "id": "kobenhavn-a2-listening-a-audio-1",
      "text": "Din aftale er flyttet fra tirsdag til torsdag klokken tre. Ring til os, hvis tiden ikke passer.",
      "stamp": "8f93ebb1251523cf",
      "bytes": 21696,
      "at": "2026-08-23T00:08:11.723Z",
      "sourceHash": "7e7abd6a52aef33e9ce7820790cd3d371ef0b83ff98466b27ab5184ac8495355"
    },
    "kobenhavn-a2-listening-b-audio-1": {
      "id": "kobenhavn-a2-listening-b-audio-1",
      "text": "Din pakke kan hentes fredag efter klokken fire. Skriv til os, hvis du ikke kan komme.",
      "stamp": "4a0fbc3d5f15b611",
      "bytes": 26784,
      "at": "2026-08-23T00:08:12.580Z",
      "sourceHash": "207649a2d723900a034b91e2cfa608801206d35d5a5e161b397269dc5dbb7ddb"
    },
    "kobenhavn-a2-reading-a-audio-1": {
      "id": "kobenhavn-a2-reading-a-audio-1",
      "text": "Læs begge tekster, og vælg en tid, der passer.",
      "stamp": "121d33d850669e7e",
      "bytes": 11904,
      "at": "2026-08-23T00:08:13.149Z",
      "sourceHash": "d4682a057840eeae1041aff38a15416ec45acff1bec6adb472414af85e1a09cf"
    },
    "kobenhavn-a2-reading-b-audio-1": {
      "id": "kobenhavn-a2-reading-b-audio-1",
      "text": "Læs begge tekster, og vælg en tid, der passer.",
