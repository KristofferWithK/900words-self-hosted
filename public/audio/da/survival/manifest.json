{
  "entries": {
    "sonderborg-situation-1-line-1": {
      "id": "sonderborg-situation-1-line-1",
      "text": "Hej! Velkommen til Sønderborg.",
      "stamp": "7e379180cf685d89",
      "bytes": 8544,
      "at": "2026-08-27T12:23:02.498Z",
      "sourceHash": "88666326a5a56bd940dbf44eab1d08a9843b421c14f3f117b69e493025b0e3bb"
    },
    "sonderborg-situation-1-line-2": {
      "id": "sonderborg-situation-1-line-2",
      "text": "Hej! Jeg hedder Mia.",
      "stamp": "173952604545dc93",
      "bytes": 8832,
      "at": "2026-08-27T12:23:03.088Z",
      "sourceHash": "6e1dbed3814df60da2944031ddf39263f012aa1dd28fbdc867f51d0e05a1c0bf"
    },
    "sonderborg-situation-1-line-3": {
      "id": "sonderborg-situation-1-line-3",
      "text": "Hyggeligt at møde dig, Mia.",
      "stamp": "965f6cb866a21b30",
      "bytes": 6816,
      "at": "2026-08-27T12:23:03.818Z",
      "sourceHash": "d63702de050276bb100147b3b5fa8c3461a4283ec844549eafcd151c0ab13864"
    },
    "sonderborg-situation-1-line-4": {
      "id": "sonderborg-situation-1-line-4",
      "text": "I lige måde.",
      "stamp": "448539a4101bb7ff",
      "bytes": 3552,
      "at": "2026-08-27T12:23:04.475Z",
      "sourceHash": "0a8fccb27d0e27c6cd60889e1fd75214d337ae5385c3f43d4525433902089f85"
    },
    "sonderborg-situation-2-line-1": {
      "id": "sonderborg-situation-2-line-1",
      "text": "Kommer du fra Canada?",
      "stamp": "8d4c4596f03d04c1",
      "bytes": 5664,
      "at": "2026-08-27T12:23:05.031Z",
      "sourceHash": "c318348066d2785bd8d6671ee0c11d0428c90fbd40c58605e34f35efb85e1dff"
    },
    "sonderborg-situation-2-line-2": {
      "id": "sonderborg-situation-2-line-2",
      "text": "Ja, jeg kommer fra Canada.",
      "stamp": "ae9d606128cc23ec",
      "bytes": 9696,
      "at": "2026-08-27T12:23:05.592Z",
      "sourceHash": "fa3dee7197f9a904f1dc3e7d1a9243d0f18f160dab432d8e63065d270583e6e8"
    },
    "sonderborg-situation-2-line-3": {
      "id": "sonderborg-situation-2-line-3",
      "text": "Velkommen. Jeg skal videre nu.",
      "stamp": "e9bd67df38ec9669",
      "bytes": 9504,
      "at": "2026-08-27T12:23:06.171Z",
      "sourceHash": "977ec56941c63a9883d5fc61444115fff80473a974ee89db4bec445cdf8fb662"
    },
    "sonderborg-situation-2-line-4": {
      "id": "sonderborg-situation-2-line-4",
      "text": "Farvel!",
      "stamp": "3cc9c2b772ecd159",
      "bytes": 3456,
      "at": "2026-08-27T12:23:06.793Z",
      "sourceHash": "01d2f69c1cb23720d50777d9ea2ab82ddba4744830fabbf312620fff80ead467"
    },
    "sonderborg-situation-3-line-1": {
      "id": "sonderborg-situation-3-line-1",
      "text": "Øh, bussen kører fra spor tre om fem minutter.",
      "stamp": "5c27db525f53d404",
      "bytes": 11904,
      "at": "2026-08-27T12:23:07.386Z",
      "sourceHash": "b96853e60e6afb7f6d3dd09a4f1f5795dff11163991f99dcf52b0b62444b02d8"
    },
    "sonderborg-situation-3-line-2": {
      "id": "sonderborg-situation-3-line-2",
      "text": "Kan du sige det igen?",
      "stamp": "68fe8f74a3fa5cf4",
      "bytes": 5376,
      "at": "2026-08-27T12:23:07.914Z",
      "sourceHash": "9e7b81a97816f163ed10be4a25c5f1c7693be5058d6a8c9732cdb0959af0f7d9"
    },
    "sonderborg-situation-3-line-3": {
      "id": "sonderborg-situation-3-line-3",
      "text": "Ja. Fra spor tre om fem minutter.",
      "stamp": "9e9127098a869f26",
      "bytes": 12576,
      "at": "2026-08-27T12:23:08.622Z",
      "sourceHash": "bc44bf62af6342b5019784a3d7ada3c35fbb44e8da0c6317c0f723272259be20"
    },
    "sonderborg-situation-3-line-4": {
      "id": "sonderborg-situation-3-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 1056,
      "at": "2026-08-27T12:23:09.154Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "sonderborg-situation-4-line-1": {
      "id": "sonderborg-situation-4-line-1",
      "text": "Undskyld, kan du hjælpe mig?",
      "stamp": "cef1d27b56d38db8",
      "bytes": 7392,
      "at": "2026-08-27T12:23:09.670Z",
      "sourceHash": "994b7c1956e2da81e8dac3faa190a0fe319cc248916a470cfa5315cd5b1430e0"
    },
    "sonderborg-situation-4-line-2": {
      "id": "sonderborg-situation-4-line-2",
      "text": "Ja, selvfølgelig.",
      "stamp": "fcb8ee064519e8d5",
      "bytes": 4704,
      "at": "2026-08-27T12:23:10.114Z",
      "sourceHash": "bd8fb1de094e176bed6d0bcd29e439fba9ef41ee3a861ee3a191cfb3e6b093a2"
    },
    "sonderborg-situation-4-line-3": {
      "id": "sonderborg-situation-4-line-3",
      "text": "Hvor er toilettet?",
      "stamp": "03058f37cd8489c9",
      "bytes": 5664,
      "at": "2026-08-27T12:23:10.696Z",
      "sourceHash": "d209ca175abb6106bb0f26347fd58cf3669e8ae6613add3c9c7a095339bdda09"
    },
    "sonderborg-situation-4-line-4": {
      "id": "sonderborg-situation-4-line-4",
      "text": "Det er lige der.",
      "stamp": "449988cb6d4bb564",
      "bytes": 5952,
      "at": "2026-08-27T12:23:11.201Z",
      "sourceHash": "68dc4ea654f3e82959708017b1d79d4b704a0c0f32b42b51a94d782b2014b568"
    },
    "ribe-situation-1-line-1": {
      "id": "ribe-situation-1-line-1",
      "text": "Hej, jeg hedder Anna. Hvor bor du?",
      "stamp": "d036d1e3b0c9e8a3",
      "bytes": 12864,
      "at": "2026-08-27T12:23:11.801Z",
      "sourceHash": "c4ee0c130a1f5a5932b15896be9560b7c51a9f95a97655a9c832e227d15140af"
    },
    "ribe-situation-1-line-2": {
      "id": "ribe-situation-1-line-2",
      "text": "Jeg bor i Odense.",
      "stamp": "4d05984ac6efc789",
      "bytes": 5856,
      "at": "2026-08-27T12:23:12.283Z",
      "sourceHash": "bcc209de8822cbb9039e39f24739d788d0b3a18e3f8053acd8303f82b36b4435"
    },
    "ribe-situation-1-line-3": {
      "id": "ribe-situation-1-line-3",
      "text": "Det er en fin by.",
      "stamp": "853575370deffcd8",
      "bytes": 4032,
      "at": "2026-08-27T12:23:12.774Z",
      "sourceHash": "410fe2fad54eec53e560780bf35b25cfda2ebba6d10d28c56ac449aa2d7726a0"
    },
    "ribe-situation-1-line-4": {
      "id": "ribe-situation-1-line-4",
      "text": "Ja, det synes jeg også.",
      "stamp": "02e5e97eb7ae69f2",
      "bytes": 5184,
      "at": "2026-08-27T12:23:13.256Z",
      "sourceHash": "b5812542447718c013ba7a3ea3fdfc8acea59551ae9941a5df580fdecb9615e4"
    },
    "ribe-situation-2-line-1": {
      "id": "ribe-situation-2-line-1",
      "text": "Hvad arbejder du med?",
      "stamp": "dda5d71c48385967",
      "bytes": 5952,
      "at": "2026-08-27T12:23:13.721Z",
      "sourceHash": "5782373cda5b5b6698fdf11d5da3cbe650b296273cc93e94dac0363da5c4e238"
    },
    "ribe-situation-2-line-2": {
      "id": "ribe-situation-2-line-2",
      "text": "Jeg arbejder som lærer.",
      "stamp": "c50b3cc4856ec81d",
      "bytes": 8064,
      "at": "2026-08-27T12:23:14.198Z",
      "sourceHash": "1309f5df9962bd3b3993954068d3a950eeee9d7ebc7786a3302ed969f295366d"
    },
    "ribe-situation-2-line-3": {
      "id": "ribe-situation-2-line-3",
      "text": "Hvor arbejder du?",
      "stamp": "ec4decd616c6272d",
      "bytes": 5184,
      "at": "2026-08-27T12:23:14.720Z",
      "sourceHash": "625507955dfa38d726c6eef4bee08e20ec8f7e83b4f977db27b0fe7c14f5c00f"
    },
    "ribe-situation-2-line-4": {
      "id": "ribe-situation-2-line-4",
      "text": "På en skole i Ribe.",
      "stamp": "a98a2c244ebc74f2",
      "bytes": 6624,
      "at": "2026-08-27T12:23:15.242Z",
      "sourceHash": "ecfa5a94122b8b1048166ff8befb9ad0170f50a9e6a678a72fb26c98039590b3"
    },
    "ribe-situation-3-line-1": {
      "id": "ribe-situation-3-line-1",
      "text": "Hvordan staver du dit navn?",
      "stamp": "37aa14a3b603ef89",
      "bytes": 7776,
      "at": "2026-08-27T12:23:15.756Z",
      "sourceHash": "b020e3e3c4dadac0f3866cbb266edac595bfd5bef53104ebf88a8b59ad2fff86"
    },
    "ribe-situation-3-line-2": {
      "id": "ribe-situation-3-line-2",
      "text": "Lea staves L-E-A.",
      "stamp": "d69c7d0ab1c96432",
      "bytes": 9504,
      "at": "2026-08-27T12:23:17.619Z",
      "sourceHash": "39ba8c34db1274b3202813157019febd169959af00eb4d45f7757c1f3c06dc02"
    },
    "ribe-situation-3-line-3": {
      "id": "ribe-situation-3-line-3",
      "text": "Tak, Lea.",
      "stamp": "cc28bb9d27e78b62",
      "bytes": 6816,
      "at": "2026-08-27T12:23:20.621Z",
      "sourceHash": "e3533dc7bdadd618a4d7b330f6f8b2d9fe7c2136159f34df135a75fe86254b19"
    },
    "ribe-situation-3-line-4": {
      "id": "ribe-situation-3-line-4",
      "text": "Selv tak.",
      "stamp": "be77a1290e913cd2",
      "bytes": 4512,
      "at": "2026-08-27T12:23:21.328Z",
      "sourceHash": "59a25c8386694b7c996b5d5358df6009ff73bf68226999fe14ce4f332128a75c"
    },
    "ribe-situation-4-line-1": {
      "id": "ribe-situation-4-line-1",
      "text": "Er det dine ting?",
      "stamp": "b0e25b12a6419d9a",
      "bytes": 4896,
      "at": "2026-08-27T12:23:21.913Z",
      "sourceHash": "a7e341a3d0a8585742f845ea98209316daf186350c091459e1afd178870d62b0"
    },
    "ribe-situation-4-line-2": {
      "id": "ribe-situation-4-line-2",
      "text": "Ja, det er mine ting.",
      "stamp": "75863d184e603ba6",
      "bytes": 9504,
      "at": "2026-08-27T12:23:22.496Z",
      "sourceHash": "bc49a088885adb632454dbc81267624c9fb16c21b626543788481e0b48889154"
    },
    "ribe-situation-4-line-3": {
      "id": "ribe-situation-4-line-3",
      "text": "Her er de.",
      "stamp": "077222b49fc08fb3",
      "bytes": 6624,
      "at": "2026-08-27T12:23:23.026Z",
      "sourceHash": "40a11df7b673baa2c6a08a0417bd564c47635309fba1bd8c5e4f9e47eb9af56e"
    },
    "ribe-situation-4-line-4": {
      "id": "ribe-situation-4-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 1152,
      "at": "2026-08-27T12:23:26.275Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "kolding-situation-1-line-1": {
      "id": "kolding-situation-1-line-1",
      "text": "Hvad vil du gerne have?",
      "stamp": "e43da6adf5b9ec40",
      "bytes": 5856,
      "at": "2026-08-27T12:23:28.209Z",
      "sourceHash": "26e7d3562a541f69237379217806826aa4dd002a7aa5c5186b5e8eea0594c3ca"
    },
    "kolding-situation-1-line-2": {
      "id": "kolding-situation-1-line-2",
      "text": "Jeg vil gerne have en sandwich og et glas vand, tak.",
      "stamp": "8ba80cb675303955",
      "bytes": 13152,
      "at": "2026-08-27T12:23:28.840Z",
      "sourceHash": "91587ff909caa8fa7bd1e9ef426367a40e37612ce4efc1ffea4d08ceda1bce5e"
    },
    "kolding-situation-1-line-3": {
      "id": "kolding-situation-1-line-3",
      "text": "Det kommer med det samme.",
      "stamp": "467c408ea1fb71dc",
      "bytes": 5376,
      "at": "2026-08-27T12:23:29.395Z",
      "sourceHash": "5d3883c105c4406245855b9c3c2cd6bc43e7e2e1a136206b60e214213a2eb4ec"
    },
    "kolding-situation-1-line-4": {
      "id": "kolding-situation-1-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4416,
      "at": "2026-08-27T12:23:29.851Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "kolding-situation-2-line-1": {
      "id": "kolding-situation-2-line-1",
      "text": "Kan jeg hjælpe?",
      "stamp": "d3ad7279f6f20710",
      "bytes": 4224,
      "at": "2026-08-27T12:23:30.429Z",
      "sourceHash": "31a382eb7ab1f1e01c4d69e5e601df458e2f54d3078e516689706db0abc15b18"
    },
    "kolding-situation-2-line-2": {
      "id": "kolding-situation-2-line-2",
      "text": "Hvor meget koster brødet?",
      "stamp": "39b27b0dfdb59ac1",
      "bytes": 6144,
      "at": "2026-08-27T12:23:33.110Z",
      "sourceHash": "9f539e6f6aeee04f127a57190f81afe944e81c5be54b33628814ecb34743e7ab"
    },
    "kolding-situation-2-line-3": {
      "id": "kolding-situation-2-line-3",
      "text": "Det koster tyve kroner.",
      "stamp": "45043805e31b6bcd",
      "bytes": 6624,
      "at": "2026-08-27T12:23:33.663Z",
      "sourceHash": "3d2bef2ef2c5386d709938cce91ea0d4e3c6fbc464554722427c9a80d92cb43e"
    },
    "kolding-situation-2-line-4": {
      "id": "kolding-situation-2-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4416,
      "at": "2026-08-27T12:23:34.215Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "kolding-situation-3-line-1": {
      "id": "kolding-situation-3-line-1",
      "text": "Jamen, vi har desværre ikke te. Vi har kaffe.",
      "stamp": "0a29ab3f7d7961a7",
      "bytes": 14112,
      "at": "2026-08-27T12:23:34.864Z",
      "sourceHash": "339da66054b94b8249800083fe714fe6f7ca264edd8a582aeec4fde8a2d3c922"
    },
    "kolding-situation-3-line-2": {
      "id": "kolding-situation-3-line-2",
      "text": "Så vil jeg gerne have kaffe, tak.",
      "stamp": "f3e287f734110423",
      "bytes": 8256,
      "at": "2026-08-27T12:23:35.455Z",
      "sourceHash": "53fef872f02159d4a7ee2b66893d267b79809e40b9c60d4a8a76eeb48dea90d2"
    },
    "kolding-situation-3-line-3": {
      "id": "kolding-situation-3-line-3",
      "text": "Selvfølgelig.",
      "stamp": "53653f4b5ed04b31",
      "bytes": 4704,
      "at": "2026-08-27T12:23:36.046Z",
      "sourceHash": "4277ff999bd47bf1e411e1284a28fed08b95eda58f58ede89bbd8efd886a0ca9"
    },
    "kolding-situation-3-line-4": {
      "id": "kolding-situation-3-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 1056,
      "at": "2026-08-27T12:23:36.443Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "kolding-situation-4-line-1": {
      "id": "kolding-situation-4-line-1",
      "text": "Var der andet?",
      "stamp": "ad8c9a469ea8adaf",
      "bytes": 3552,
      "at": "2026-08-27T12:23:36.879Z",
      "sourceHash": "5356600048ec1c601c5c12b025a2229582d99d9e0a5873ac76413f6e1a58c678"
    },
    "kolding-situation-4-line-2": {
      "id": "kolding-situation-4-line-2",
      "text": "Ja, én ting mere: regningen, tak.",
      "stamp": "3b685d08020caef4",
      "bytes": 11712,
      "at": "2026-08-27T12:23:37.579Z",
      "sourceHash": "5d298631a7fb45efc8ad1ae69ed65f2dc0e0fcd3bdd948c917be6d77f10eb080"
    },
    "kolding-situation-4-line-3": {
      "id": "kolding-situation-4-line-3",
      "text": "Ja, et øjeblik.",
      "stamp": "c5e07ca4e7c7ee28",
      "bytes": 9696,
      "at": "2026-08-27T12:23:38.119Z",
      "sourceHash": "5a2b69f9734d3bff31b2f02b252f1244fc0871a0cfaa8ff2a4dbb51babb37a04"
    },
    "kolding-situation-4-line-4": {
      "id": "kolding-situation-4-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4416,
      "at": "2026-08-27T12:23:38.583Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "aarhus-situation-1-line-1": {
      "id": "aarhus-situation-1-line-1",
      "text": "Undervisningen er i lokale tre.",
      "stamp": "fc7f14476a87f143",
      "bytes": 9024,
      "at": "2026-08-27T12:23:39.326Z",
      "sourceHash": "ffaf18aa17590bd76dcb4eee0fb3e80703a1ebb481dfa5ba0432a6db5d088e04"
    },
    "aarhus-situation-1-line-2": {
      "id": "aarhus-situation-1-line-2",
      "text": "Hvornår begynder undervisningen?",
      "stamp": "e3043af17afe9fe1",
      "bytes": 6816,
      "at": "2026-08-27T12:23:39.800Z",
      "sourceHash": "710f81cc0fad729ccc7394dac07213d68fcdff6dd5906ded1f6678ccdad83245"
    },
    "aarhus-situation-1-line-3": {
      "id": "aarhus-situation-1-line-3",
      "text": "Den begynder klokken ni.",
      "stamp": "e1d297421fbcdaeb",
      "bytes": 5952,
      "at": "2026-08-27T12:23:40.285Z",
      "sourceHash": "0f61fc692621756a2c7b6945a73ef76c84e1dae2df4ac22dd2c5fa389136e278"
    },
    "aarhus-situation-1-line-4": {
      "id": "aarhus-situation-1-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4416,
      "at": "2026-08-27T12:23:40.856Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "aarhus-situation-2-line-1": {
      "id": "aarhus-situation-2-line-1",
      "text": "Fortæl kort om i går og i dag.",
      "stamp": "09632bf74488f427",
      "bytes": 9696,
      "at": "2026-08-27T12:23:41.554Z",
      "sourceHash": "8c070f673ae91ce1574c766f076c03259af42c36de4f02249e28cc46ad0278bf"
    },
    "aarhus-situation-2-line-2": {
      "id": "aarhus-situation-2-line-2",
      "text": "I går købte jeg brød og læste en bog.",
      "stamp": "21bd5e0d15852829",
      "bytes": 13152,
      "at": "2026-08-27T12:23:42.206Z",
      "sourceHash": "990acf61dd26cc066d29156c6a24664bd0b90e1ae93345c15499d368329becea"
    },
    "aarhus-situation-2-line-3": {
      "id": "aarhus-situation-2-line-3",
      "text": "I dag har jeg lavet mad.",
      "stamp": "3842b04014eb6fd1",
      "bytes": 5664,
      "at": "2026-08-27T12:23:42.708Z",
      "sourceHash": "e58e8c13c8d946971476c12133ae8b6cbee7e42ea4fdab9ea5f14ecd529cb830"
    },
    "aarhus-situation-2-line-4": {
      "id": "aarhus-situation-2-line-4",
      "text": "Det lyder godt.",
      "stamp": "d2a7ecc5e8483e3e",
      "bytes": 6816,
      "at": "2026-08-27T12:23:43.242Z",
      "sourceHash": "b11a4e810f6d6d6fe4423c055a4bad77cf844c7ff6a45ceed283caeb22d95a32"
    },
    "aarhus-situation-3-line-1": {
      "id": "aarhus-situation-3-line-1",
      "text": "Øh, kan vi mødes klokken ni?",
      "stamp": "dd2116ca5910c1eb",
      "bytes": 7392,
      "at": "2026-08-27T12:23:43.783Z",
      "sourceHash": "aa6edf7fd6165b9cc95074680512050e54dba312e789fa1fdffd58075a69b96e"
    },
    "aarhus-situation-3-line-2": {
      "id": "aarhus-situation-3-line-2",
      "text": "Jeg kan ikke mødes klokken ni.",
      "stamp": "e4d567a5c6d445c6",
      "bytes": 7104,
      "at": "2026-08-27T12:23:44.310Z",
      "sourceHash": "b73d18604331d6dde264ed949c77e789960ad5fe1ebbce080dc7021fa9938753"
    },
    "aarhus-situation-3-line-3": {
      "id": "aarhus-situation-3-line-3",
      "text": "Hvornår kan du?",
      "stamp": "d8d0965b27ac73b4",
      "bytes": 4032,
      "at": "2026-08-27T12:23:45.068Z",
      "sourceHash": "5729f7e210e68b53a4870737db1ed8f9d3eb11a85adc597ca486cac70a3ab814"
    },
    "aarhus-situation-3-line-4": {
      "id": "aarhus-situation-3-line-4",
      "text": "Klokken ti passer bedre.",
      "stamp": "bbeae84ad2f774e7",
      "bytes": 7104,
      "at": "2026-08-27T12:23:45.781Z",
      "sourceHash": "fca1ce0e8a89c15e4a9c0ab62248b8a57d99db9e42ac107d5529df86df4a927e"
    },
    "aarhus-situation-4-line-1": {
      "id": "aarhus-situation-4-line-1",
      "text": "Jeg kan i hvert fald ikke klokken ni. Kan du senere?",
      "stamp": "ebb9663acc9577b7",
      "bytes": 12096,
      "at": "2026-08-27T12:23:46.461Z",
      "sourceHash": "0337b274f416be51383ecd4456105492b55cc33e7518272f154774c4557ade33"
    },
    "aarhus-situation-4-line-2": {
      "id": "aarhus-situation-4-line-2",
      "text": "Kan vi mødes i morgen klokken ti i stedet?",
      "stamp": "5d9be49394510c71",
      "bytes": 9024,
      "at": "2026-08-27T12:23:46.966Z",
      "sourceHash": "8bfabcaf5c363af46d8d3becb0ced65728197981d44312d747213a56cdb03972"
    },
    "aarhus-situation-4-line-3": {
      "id": "aarhus-situation-4-line-3",
      "text": "Ja, det passer fint.",
      "stamp": "cce3c1afca718899",
      "bytes": 7584,
      "at": "2026-08-27T12:23:47.501Z",
      "sourceHash": "2165bdc42355a1b0800aef33e5475c97c0e8bc072d1058c107929668bc810593"
    },
    "aarhus-situation-4-line-4": {
      "id": "aarhus-situation-4-line-4",
      "text": "Godt, vi ses.",
      "stamp": "dc12cb9d80636c12",
      "bytes": 8544,
      "at": "2026-08-27T12:23:48.188Z",
      "sourceHash": "5751ef3cdd948405c055f5004fb3b8e36aa067eb6af60aba38c8e38767d62909"
    },
    "aalborg-situation-1-line-1": {
      "id": "aalborg-situation-1-line-1",
      "text": "Undskyld, hvor er spor to?",
      "stamp": "d8207fe65f5590fd",
      "bytes": 6816,
      "at": "2026-08-27T12:23:48.706Z",
      "sourceHash": "bc090fc5c66baf81e3bcc6880b12fb17fab40eef2d7ee8ceb9761e530ae8f453"
    },
    "aalborg-situation-1-line-2": {
      "id": "aalborg-situation-1-line-2",
      "text": "Ligeud og til højre.",
      "stamp": "3be69412eb444443",
      "bytes": 8352,
      "at": "2026-08-27T12:23:49.197Z",
      "sourceHash": "2fc8ad4a4b5a644cfa7a3fa11dfb374449d145bbe3f4ff281ab70b780b3d7f7c"
    },
    "aalborg-situation-1-line-3": {
      "id": "aalborg-situation-1-line-3",
      "text": "Tak for hjælpen.",
      "stamp": "0b06885cdffc9e2c",
      "bytes": 5472,
      "at": "2026-08-27T12:23:49.694Z",
      "sourceHash": "dbb03b7a4ff74466e04a59e7f1aff17f779b75885a127cf314e0a67f5282dae4"
    },
    "aalborg-situation-1-line-4": {
      "id": "aalborg-situation-1-line-4",
      "text": "Selv tak.",
      "stamp": "be77a1290e913cd2",
      "bytes": 6624,
      "at": "2026-08-27T12:23:50.203Z",
      "sourceHash": "59a25c8386694b7c996b5d5358df6009ff73bf68226999fe14ce4f332128a75c"
    },
    "aalborg-situation-2-line-1": {
      "id": "aalborg-situation-2-line-1",
      "text": "Hvor skal du hen?",
      "stamp": "97a08ace81a6a803",
      "bytes": 4416,
      "at": "2026-08-27T12:23:51.574Z",
      "sourceHash": "d3b1489c77657b5b9cbd340543157562473a038fa2caa34fc6c4a8271811c690"
    },
    "aalborg-situation-2-line-2": {
      "id": "aalborg-situation-2-line-2",
      "text": "En billet til Skagen, tak.",
      "stamp": "d25fec913a41cf45",
      "bytes": 7872,
      "at": "2026-08-27T12:23:52.113Z",
      "sourceHash": "7d99782eab0357da71bc53bf84fdd02a8b6444b8ddf7253267adc857fba4d623"
    },
    "aalborg-situation-2-line-3": {
      "id": "aalborg-situation-2-line-3",
      "text": "En enkeltbillet?",
      "stamp": "031fcbaba1dec108",
      "bytes": 6624,
      "at": "2026-08-27T12:23:52.611Z",
      "sourceHash": "3f99cb8e8235fda6db1ccbb98eae3c52208c64831cc46b4f5023ea20da5b9ecb"
    },
    "aalborg-situation-2-line-4": {
      "id": "aalborg-situation-2-line-4",
      "text": "Ja, tak.",
      "stamp": "a5ce90edd83e03c1",
      "bytes": 5664,
      "at": "2026-08-27T12:23:53.170Z",
      "sourceHash": "13e75d763391616598b11f24890091935fdfece714b83ac246c78e8604b3cf5b"
    },
    "aalborg-situation-3-line-1": {
      "id": "aalborg-situation-3-line-1",
      "text": "Gå ligeud til kirken.",
      "stamp": "14f150210fd4fc81",
      "bytes": 8832,
      "at": "2026-08-27T12:23:53.747Z",
      "sourceHash": "66ee62f83933d0f74ff0f35c6a0e8690ec9a767e45afa326ef8f7517fa10ac3e"
    },
    "aalborg-situation-3-line-2": {
      "id": "aalborg-situation-3-line-2",
      "text": "Skal jeg dreje til højre her?",
      "stamp": "0cdc09b562507546",
      "bytes": 8256,
      "at": "2026-08-27T12:23:54.263Z",
      "sourceHash": "02de3dc83fe26e7f5471b75225f431ddf26d0477d270f02b9a9556b8a8920406"
    },
    "aalborg-situation-3-line-3": {
      "id": "aalborg-situation-3-line-3",
      "text": "Ja, til højre ved kirken.",
      "stamp": "6cbd61f8ad032510",
      "bytes": 10656,
      "at": "2026-08-27T12:23:54.837Z",
      "sourceHash": "0c421a2887face326b1b7d92cfe1973d857a81f3584df3b1bd346d061045bd00"
    },
    "aalborg-situation-3-line-4": {
      "id": "aalborg-situation-3-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4704,
      "at": "2026-08-27T12:23:55.387Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "aalborg-situation-4-line-1": {
      "id": "aalborg-situation-4-line-1",
      "text": "Hvad lavede du i går?",
      "stamp": "f7ee8d6362d367ee",
      "bytes": 6624,
      "at": "2026-08-27T12:23:55.881Z",
      "sourceHash": "997518d57a4fa674e064b51ab36ea469c4372dd017c1c4df0f34d1782dedcc84"
    },
    "aalborg-situation-4-line-2": {
      "id": "aalborg-situation-4-line-2",
      "text": "I går lavede jeg mad og købte brød.",
      "stamp": "8914087f6658a18d",
      "bytes": 10944,
      "at": "2026-08-27T12:23:56.420Z",
      "sourceHash": "a46d32bf1c568c602bcda2e745e5d2d1fa0631b5a0530d4dcf9ecc0484468bfe"
    },
    "aalborg-situation-4-line-3": {
      "id": "aalborg-situation-4-line-3",
      "text": "Og i dag?",
      "stamp": "b0b9c17e4d9ff14b",
      "bytes": 4224,
      "at": "2026-08-27T12:23:57.279Z",
      "sourceHash": "ca7c4cf89240950ec17eda20b37b8ddff9db9833f70abd129f06bc48ce8d0388"
    },
    "aalborg-situation-4-line-4": {
      "id": "aalborg-situation-4-line-4",
      "text": "I dag har jeg arbejdet hjemme.",
      "stamp": "b16b15570b36c6ee",
      "bytes": 6816,
      "at": "2026-08-27T12:23:57.807Z",
      "sourceHash": "02dba88858c6a28c7d783dbf614b4fcdba0485d11544ffebc8b51801449a50ae"
    },
    "skagen-situation-1-line-1": {
      "id": "skagen-situation-1-line-1",
      "text": "Hvordan er vejret i dag?",
      "stamp": "db020503495f66c9",
      "bytes": 5664,
      "at": "2026-08-27T12:23:58.318Z",
      "sourceHash": "a7fe0421569cb87552d901e829c0255ae9a3b386abc2273e4c5b9cae1f77343d"
    },
    "skagen-situation-1-line-2": {
      "id": "skagen-situation-1-line-2",
      "text": "Det er koldt, men der er sol.",
      "stamp": "a06f250fac6cd963",
      "bytes": 6624,
      "at": "2026-08-27T12:23:58.878Z",
      "sourceHash": "da8a3091580e1d211c083438d3267a6cefc5e901405065c7b5213a5527f38586"
    },
    "skagen-situation-1-line-3": {
      "id": "skagen-situation-1-line-3",
      "text": "Så tager vi en jakke med.",
      "stamp": "633f820db9de2596",
      "bytes": 9216,
      "at": "2026-08-27T12:23:59.660Z",
      "sourceHash": "f144918bec44ad05e135d2596de0edbe50d767c263df0eafd8c6124edafc15a9"
    },
    "skagen-situation-1-line-4": {
      "id": "skagen-situation-1-line-4",
      "text": "God idé.",
      "stamp": "83b8a500ea3ea4e9",
      "bytes": 5664,
      "at": "2026-08-27T12:24:00.165Z",
      "sourceHash": "9b95610b90b2f38f21268505502f5e25ba5b3e437c6aa3c8414d94f777520fd3"
    },
    "skagen-situation-2-line-1": {
      "id": "skagen-situation-2-line-1",
      "text": "Hvad vil du spise?",
      "stamp": "c311ad9a8448df67",
      "bytes": 5664,
      "at": "2026-08-27T12:24:00.976Z",
      "sourceHash": "b2147b0557d795804edca30c6cdb8327f3c66f9c38187ff2275ac8f2c470502e"
    },
    "skagen-situation-2-line-2": {
      "id": "skagen-situation-2-line-2",
      "text": "Jeg vil gerne have suppe, fordi den er varm.",
      "stamp": "87ece21f46a6e51c",
      "bytes": 9984,
      "at": "2026-08-27T12:24:01.562Z",
      "sourceHash": "67495abb7a22b93b8614269d7b5ef513de81545658678ff014316e275c261b41"
    },
    "skagen-situation-2-line-3": {
      "id": "skagen-situation-2-line-3",
      "text": "Det er et godt valg.",
      "stamp": "e34d36cd99aaf729",
      "bytes": 4224,
      "at": "2026-08-27T12:24:02.002Z",
      "sourceHash": "ab74cb582ac92225e375cc00e56decf063bea1c55771732a6add6f410c77f5b7"
    },
    "skagen-situation-2-line-4": {
      "id": "skagen-situation-2-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 6624,
      "at": "2026-08-27T12:24:02.515Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "skagen-situation-3-line-1": {
      "id": "skagen-situation-3-line-1",
      "text": "Jamen, færgen sejler først klokken seksten.",
      "stamp": "6015ccc67590cd5e",
      "bytes": 10752,
      "at": "2026-08-27T12:24:03.060Z",
      "sourceHash": "d68ce65ec86f0c4e45d4c3d5863dcd09400dedffa86ed17a3e165ef779c2cbbf"
    },
    "skagen-situation-3-line-2": {
      "id": "skagen-situation-3-line-2",
      "text": "Kan du sige den nye tid igen?",
      "stamp": "a9e03163596efb7a",
      "bytes": 6816,
      "at": "2026-08-27T12:24:03.694Z",
      "sourceHash": "10b1220381878229922179be67c08596f4438138f14c760af445dacdad5d476f"
    },
    "skagen-situation-3-line-3": {
      "id": "skagen-situation-3-line-3",
      "text": "Ja, klokken seksten.",
      "stamp": "78c523170c738e8f",
      "bytes": 7296,
      "at": "2026-08-27T12:24:04.221Z",
      "sourceHash": "1da68ea5e598dfe196d0aecd0c48bd43ff38b11480bdd1bc474a8d110586e0d7"
    },
    "skagen-situation-3-line-4": {
      "id": "skagen-situation-3-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4416,
      "at": "2026-08-27T12:24:04.762Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "skagen-situation-4-line-1": {
      "id": "skagen-situation-4-line-1",
      "text": "Hvordan er det?",
      "stamp": "ac3f3faf0506b2a7",
      "bytes": 4032,
      "at": "2026-08-27T12:24:05.288Z",
      "sourceHash": "fdcaed653f70694167a3733d895b0d18a5e645c31877ebeb3fb039c2ff0cd6e3"
    },
    "skagen-situation-4-line-2": {
      "id": "skagen-situation-4-line-2",
      "text": "Det er et smukt og roligt sted.",
      "stamp": "13934ddefc6ffcbe",
      "bytes": 7872,
      "at": "2026-08-27T12:24:05.869Z",
      "sourceHash": "e7b01c8426887b4cc0a8c1abc89fa63e0f95f1097ce9f840ddfb3cf52cf35d98"
    },
    "skagen-situation-4-line-3": {
      "id": "skagen-situation-4-line-3",
      "text": "Og hvad lavede du?",
      "stamp": "2d665edc865516c3",
      "bytes": 4896,
      "at": "2026-08-27T12:24:06.455Z",
      "sourceHash": "4a3066639ab40cd7d6cc373b9869e19fe47688cc359dd96e7c810e2f791e5e26"
    },
    "skagen-situation-4-line-4": {
      "id": "skagen-situation-4-line-4",
      "text": "I går læste jeg en bog der. I dag har jeg købt kaffe på caféen.",
      "stamp": "94e4cb0fbbdd91f2",
      "bytes": 17664,
      "at": "2026-08-27T12:24:07.383Z",
      "sourceHash": "84b167cae41efe43b30a38e79835d78274d13cc2cb1d2aba07848934d97e2768"
    },
    "odense-situation-1-line-1": {
      "id": "odense-situation-1-line-1",
      "text": "Ej, hvad skete der?",
      "stamp": "6edb0289eb3fa949",
      "bytes": 7296,
      "at": "2026-08-27T12:24:08.068Z",
      "sourceHash": "7d3c153e8ec41b2f1e30c5aab20a8d162eec9fc2a2d435e670585abbf212d4ac"
    },
    "odense-situation-1-line-2": {
      "id": "odense-situation-1-line-2",
      "text": "Toget var forsinket, så jeg missede bussen.",
      "stamp": "68964bf76f47b608",
      "bytes": 10272,
      "at": "2026-08-27T12:24:08.856Z",
      "sourceHash": "6c46ee1bdb49f5d689ae0c1df0f3963b31a78e68c9b4dfa2bfaccb02dc89fbb8"
    },
    "odense-situation-1-line-3": {
      "id": "odense-situation-1-line-3",
      "text": "Jeg kan hjælpe dig med en ny billet.",
      "stamp": "b7b9aae23ef32d53",
      "bytes": 6624,
      "at": "2026-08-27T12:24:09.365Z",
      "sourceHash": "eba51500ccc3ad77b5d8797fa0fb19d009b40429db9bb24325513a9b00c6bc77"
    },
    "odense-situation-1-line-4": {
      "id": "odense-situation-1-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 1152,
      "at": "2026-08-27T12:24:09.795Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "odense-situation-2-line-1": {
      "id": "odense-situation-2-line-1",
      "text": "Ej, var tasken sort, ligesom den her?",
      "stamp": "f7326229aac52808",
      "bytes": 9984,
      "at": "2026-08-27T12:24:10.381Z",
      "sourceHash": "33f00fa6802d366f3e43e6d153be41d8482fa480c049132c23474276ea5bc015"
    },
    "odense-situation-2-line-2": {
      "id": "odense-situation-2-line-2",
      "text": "Ja. Jeg har mistet to ting: tasken og et kamera.",
      "stamp": "42abe1679ef99790",
      "bytes": 20544,
      "at": "2026-08-27T12:24:11.283Z",
      "sourceHash": "297e529dda1f1585c41bf596942382803dd91f77d4f87e249ab9910017b7bcc9"
    },
    "odense-situation-2-line-3": {
      "id": "odense-situation-2-line-3",
      "text": "Hvor så du dem sidst?",
      "stamp": "b7ffc71f82a23824",
      "bytes": 4704,
      "at": "2026-08-27T12:24:11.832Z",
      "sourceHash": "13461ba47c8dd39909309c5f5ab57897b679fa7f8ca81617567ff0312900c0da"
    },
    "odense-situation-2-line-4": {
      "id": "odense-situation-2-line-4",
      "text": "I bussen.",
      "stamp": "a43f4650517fb78a",
      "bytes": 3936,
      "at": "2026-08-27T12:24:12.493Z",
      "sourceHash": "8b3097453fd30cd0fd2bfbffd69bea25b701799d2f4252ff8687b877f1cb4f92"
    },
    "odense-situation-3-line-1": {
      "id": "odense-situation-3-line-1",
      "text": "Hvad er der galt?",
      "stamp": "321a6515b8d2e840",
      "bytes": 5952,
      "at": "2026-08-27T12:24:13.258Z",
      "sourceHash": "78ec8dcec3d356a4f85da3bab29c33b35f115cf2ef5421e53ae59cbcafffc17d"
    },
    "odense-situation-3-line-2": {
      "id": "odense-situation-3-line-2",
      "text": "Jeg har ondt i hovedet.",
      "stamp": "f5d0847044d789ca",
      "bytes": 6624,
      "at": "2026-08-27T12:24:13.717Z",
      "sourceHash": "94e58aada03cd21687d03b3db7e8e78e162a33cf8ade02dcc5db00cbf444a3cb"
    },
    "odense-situation-3-line-3": {
      "id": "odense-situation-3-line-3",
      "text": "Har du haft feber?",
      "stamp": "8acd357e8ff3f4f6",
      "bytes": 6144,
      "at": "2026-08-27T12:24:14.220Z",
      "sourceHash": "9621aeb8775d1a208f83d0d7f6d5571493abceca09b9d874724219d106b14415"
    },
    "odense-situation-3-line-4": {
      "id": "odense-situation-3-line-4",
      "text": "Ja, jeg har haft feber siden i går.",
      "stamp": "3bceed41518b9d18",
      "bytes": 10176,
      "at": "2026-08-27T12:24:14.876Z",
      "sourceHash": "21519e43399ba3cd234c65c1e3813743eafaf49f71ae8fb56658c467ca4ca93b"
    },
    "odense-situation-4-line-1": {
      "id": "odense-situation-4-line-1",
      "text": "Jeg kan godt se problemet.",
      "stamp": "e73f689a8112c3d8",
      "bytes": 5856,
      "at": "2026-08-27T12:24:15.381Z",
      "sourceHash": "286882a4efee76a547d882ecfeb5070c070916712508a6b640eadbbc2fc9a072"
    },
    "odense-situation-4-line-2": {
      "id": "odense-situation-4-line-2",
      "text": "Hvad skal jeg gøre nu?",
      "stamp": "d8498d7a6e303ce6",
      "bytes": 5376,
      "at": "2026-08-27T12:24:15.845Z",
      "sourceHash": "cf508520b6ff3d832a851e2d148d6d74b5c0a31a942387fc70da118cccdb40f4"
    },
    "odense-situation-4-line-3": {
      "id": "odense-situation-4-line-3",
      "text": "Gå til skranken ved siden af.",
      "stamp": "200765be6afc6494",
      "bytes": 8064,
      "at": "2026-08-27T12:24:16.396Z",
      "sourceHash": "1df0d7b9dd8817f21b45fe6dbd6ef19358a7e6e2bd5c2bf50e8832c9ab86ab0a"
    },
    "odense-situation-4-line-4": {
      "id": "odense-situation-4-line-4",
      "text": "Tak for hjælpen.",
      "stamp": "0b06885cdffc9e2c",
      "bytes": 4704,
      "at": "2026-08-27T12:24:16.907Z",
      "sourceHash": "dbb03b7a4ff74466e04a59e7f1aff17f779b75885a127cf314e0a67f5282dae4"
    },
    "roskilde-situation-1-line-1": {
      "id": "roskilde-situation-1-line-1",
      "text": "Øh, har du planer på fredag?",
      "stamp": "f539b35c62b74a0c",
      "bytes": 9504,
      "at": "2026-08-27T12:24:17.574Z",
      "sourceHash": "d1a25638d7dceb028bc316ddf7d4a2330d9304188fcd5da03ed798305daf5631"
    },
    "roskilde-situation-1-line-2": {
      "id": "roskilde-situation-1-line-2",
      "text": "Har du lyst til at gå til koncert fredag?",
      "stamp": "6d76a7d69f0557f1",
      "bytes": 8256,
      "at": "2026-08-27T12:24:18.125Z",
      "sourceHash": "48d3b2a929893f18acee86a5fc17c676b81d8c8c33cc1ed2c2448fab36ac6ff5"
    },
    "roskilde-situation-1-line-3": {
      "id": "roskilde-situation-1-line-3",
      "text": "Ja, det vil jeg gerne.",
      "stamp": "0139fbdf107844a7",
      "bytes": 6144,
      "at": "2026-08-27T12:24:18.648Z",
      "sourceHash": "eac5acd354fa1cc162ada60722e969c729458a4e0585d821201f5aa6f3f5028b"
    },
    "roskilde-situation-1-line-4": {
      "id": "roskilde-situation-1-line-4",
      "text": "Godt.",
      "stamp": "acf3f6efd2a4b1a8",
      "bytes": 4704,
      "at": "2026-08-27T12:24:19.163Z",
      "sourceHash": "9350875666caca0fe107da0e3715f652e94fd3a2dda0d909f6e7180d0ef03b15"
    },
    "roskilde-situation-2-line-1": {
      "id": "roskilde-situation-2-line-1",
      "text": "Kan du komme fredag?",
      "stamp": "359a2b8bdd973bc0",
      "bytes": 4992,
      "at": "2026-08-27T12:24:19.751Z",
      "sourceHash": "9e5daf85a7750e150ae64e0f646eedbe5db0675d2108eb171a6d00599e31a725"
    },
    "roskilde-situation-2-line-2": {
      "id": "roskilde-situation-2-line-2",
      "text": "Det kan jeg desværre ikke på fredag.",
      "stamp": "81cfe7c7c5d87096",
      "bytes": 8064,
      "at": "2026-08-27T12:24:20.411Z",
      "sourceHash": "bd8abc97356ba630c3cfad2ef134e3ea813ec374e333a6000327598724dbb85e"
    },
    "roskilde-situation-2-line-3": {
      "id": "roskilde-situation-2-line-3",
      "text": "Jeg kan i hvert fald lørdag. Passer det?",
      "stamp": "ef076b9ec221a257",
      "bytes": 12576,
      "at": "2026-08-27T12:24:21.566Z",
      "sourceHash": "d6989102e345fc2bc0b4114633737ee3be3f58ae3b94e49b97ee2ccde612ab6e"
    },
    "roskilde-situation-2-line-4": {
      "id": "roskilde-situation-2-line-4",
      "text": "Ja, lørdag passer fint.",
      "stamp": "6ff17816f03c0e78",
      "bytes": 8352,
      "at": "2026-08-27T12:24:22.201Z",
      "sourceHash": "824cfb3b33423a87304b60fd40a40273e75d68304f28510f33eb8f5b0b5637de"
    },
    "roskilde-situation-3-line-1": {
      "id": "roskilde-situation-3-line-1",
      "text": "Du skal bestille en billet.",
      "stamp": "6b35cea07612b50c",
      "bytes": 7104,
      "at": "2026-08-27T12:24:22.787Z",
      "sourceHash": "54bd572e8516b7b05a7c162fa67bca070f75d9089a41afe36c92d260ed52ac14"
    },
    "roskilde-situation-3-line-2": {
      "id": "roskilde-situation-3-line-2",
      "text": "Jeg skal bestille, men jeg må gerne betale senere?",
      "stamp": "f10fda17ea81ab9c",
      "bytes": 12864,
      "at": "2026-08-27T12:24:23.399Z",
      "sourceHash": "0ad7c21035c9f83df2765bf42b63c8b0d3a4da129ced21ff3bb4215551a81a1e"
    },
    "roskilde-situation-3-line-3": {
      "id": "roskilde-situation-3-line-3",
      "text": "Ja, det må du gerne.",
      "stamp": "f7eb0da7804afcfb",
      "bytes": 6624,
      "at": "2026-08-27T12:24:24.002Z",
      "sourceHash": "bed8d6177e8602de1ab1b2bc6528f235d43fe0abc84f58eae20490ad89f61a07"
    },
    "roskilde-situation-3-line-4": {
      "id": "roskilde-situation-3-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 4704,
      "at": "2026-08-27T12:24:24.616Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "roskilde-situation-4-line-1": {
      "id": "roskilde-situation-4-line-1",
      "text": "Lørdag klokken seks eller søndag klokken elleve?",
      "stamp": "1bfb914622565d07",
      "bytes": 10464,
      "at": "2026-08-27T12:24:25.164Z",
      "sourceHash": "f971398f68d781220688568d782bafa42a0ac75737b1a635d8b62303bdddcec4"
    },
    "roskilde-situation-4-line-2": {
      "id": "roskilde-situation-4-line-2",
      "text": "Søndag klokken elleve passer bedre.",
      "stamp": "08cefb7d10a172d1",
      "bytes": 9696,
      "at": "2026-08-27T12:24:25.708Z",
      "sourceHash": "3c920f6246d6af3aa406f4814572c667771cfda34539c079991be92f6b64734b"
    },
    "roskilde-situation-4-line-3": {
      "id": "roskilde-situation-4-line-3",
      "text": "Vi mødes på stationen.",
      "stamp": "e6b3b838bac7ec6c",
      "bytes": 7392,
      "at": "2026-08-27T12:24:26.345Z",
      "sourceHash": "7324a27a601e513a84b3117cc94b481f097beb86f691158b1746752ebaf73110"
    },
    "roskilde-situation-4-line-4": {
      "id": "roskilde-situation-4-line-4",
      "text": "Aftale.",
      "stamp": "92b5da50483b2dfe",
      "bytes": 4032,
      "at": "2026-08-27T12:24:26.798Z",
      "sourceHash": "fd8ab7f6bc1f4afd592a6a0be6460c966e9d05ce571ae6fa8975d9141ceacad7"
    },
    "kobenhavn-situation-1-line-1": {
      "id": "kobenhavn-situation-1-line-1",
      "text": "Hvad kan jeg hjælpe med?",
      "stamp": "57b37167a076c70b",
      "bytes": 5664,
      "at": "2026-08-27T12:24:27.438Z",
      "sourceHash": "d53ea5001731fabef0fe9c202e2b6ca0e196dfc928ade0ef948098ba8af2a8c1"
    },
    "kobenhavn-situation-1-line-2": {
      "id": "kobenhavn-situation-1-line-2",
      "text": "Jeg vil gerne ændre min aftale, fordi tirsdag ikke passer.",
      "stamp": "d2e5d9b673465a0b",
      "bytes": 14112,
      "at": "2026-08-27T12:24:28.053Z",
      "sourceHash": "01e9674ab622f420175b278103d782c4af382e0b757452b00365ee4dfbcc1333"
    },
    "kobenhavn-situation-1-line-3": {
      "id": "kobenhavn-situation-1-line-3",
      "text": "Hvilken dag passer bedre?",
      "stamp": "c5ce11f0c75b0c1f",
      "bytes": 7584,
      "at": "2026-08-27T12:24:28.715Z",
      "sourceHash": "9e8758dbc8f1eb558537cec9de70ea5f7f215a4ca166a6973bbe903e1e09d48a"
    },
    "kobenhavn-situation-1-line-4": {
      "id": "kobenhavn-situation-1-line-4",
      "text": "Torsdag passer bedre.",
      "stamp": "b11568827b3d4116",
      "bytes": 5856,
      "at": "2026-08-27T12:24:29.262Z",
      "sourceHash": "9bcbbe46b15d1aa25f9097a443dc43c3f12afd7cec7384630fa82e3b7c2d28fa"
    },
    "kobenhavn-situation-2-line-1": {
      "id": "kobenhavn-situation-2-line-1",
      "text": "Er problemet ligesom i går?",
      "stamp": "0f990d892e5833e9",
      "bytes": 6144,
      "at": "2026-08-27T12:24:30.050Z",
      "sourceHash": "2e333d3a1fa6afbbe4b4a8fe23e7aaedb7f9b5b0f53c089ecbb1754d86842af7"
    },
    "kobenhavn-situation-2-line-2": {
      "id": "kobenhavn-situation-2-line-2",
      "text": "Jeg kan ikke logge ind.",
      "stamp": "a866e557864cf408",
      "bytes": 4416,
      "at": "2026-08-27T12:24:30.555Z",
      "sourceHash": "18b83180b7487adbb66d1e9d7292052a2dfe0b92cdf9f8a3aa520c4db472ec2b"
    },
    "kobenhavn-situation-2-line-3": {
      "id": "kobenhavn-situation-2-line-3",
      "text": "Hvad skal jeg gøre?",
      "stamp": "32a4de86f0b8f243",
      "bytes": 6816,
      "at": "2026-08-27T12:24:31.333Z",
      "sourceHash": "f7e57e05b5f5fd0fff7579e97970910db3ac1142c449dfb18f3d6eee27bf58c8"
    },
    "kobenhavn-situation-2-line-4": {
      "id": "kobenhavn-situation-2-line-4",
      "text": "Prøv at nulstille din adgangskode.",
      "stamp": "aa4af065154b1424",
      "bytes": 9024,
      "at": "2026-08-27T12:24:31.931Z",
      "sourceHash": "fa7fb1a74169edddff672f789d723233df17bdf1fa3c4a63e115e4eb2915cff3"
    },
    "kobenhavn-situation-3-line-1": {
      "id": "kobenhavn-situation-3-line-1",
      "text": "Hvad er problemet i lejligheden?",
      "stamp": "b2deddb0c112dc5d",
      "bytes": 9024,
      "at": "2026-08-27T12:24:32.551Z",
      "sourceHash": "d7f3f19f3abfde5446a3a09887920f559c1efc301a4bf11628924745f2d84251"
    },
    "kobenhavn-situation-3-line-2": {
      "id": "kobenhavn-situation-3-line-2",
      "text": "Vinduet er i stykker, så værelset er koldt.",
      "stamp": "77249c51a7335327",
      "bytes": 11424,
      "at": "2026-08-27T12:24:33.245Z",
      "sourceHash": "d3f576792ea4a7769f60145e0d57e35d88c4f5a8f6a5ceb583e13442e5729b91"
    },
    "kobenhavn-situation-3-line-3": {
      "id": "kobenhavn-situation-3-line-3",
      "text": "Jeg sender en vicevært.",
      "stamp": "8a12131e20ce6895",
      "bytes": 5952,
      "at": "2026-08-27T12:24:33.751Z",
      "sourceHash": "abf013743b6983e00941608aa81ddf84e991a1f492db470bfc65bc784266e387"
    },
    "kobenhavn-situation-3-line-4": {
      "id": "kobenhavn-situation-3-line-4",
      "text": "Tak.",
      "stamp": "344c72e9ffeb7033",
      "bytes": 3456,
      "at": "2026-08-27T12:24:34.166Z",
      "sourceHash": "513b01a3bb23dff8d293ea0ebd873ee7a355a9725a94e7275d16b9b8f7011f77"
    },
    "kobenhavn-situation-4-line-1": {
      "id": "kobenhavn-situation-4-line-1",
      "text": "Der er et gebyr ved sen aflysning.",
      "stamp": "1e6ccbf25fa4fb76",
      "bytes": 9984,
      "at": "2026-08-27T12:24:34.695Z",
      "sourceHash": "b6d56e0591010b8cc79c4536758785385eef536d7e0d6db08dac8e4ae5c4564b"
    },
    "kobenhavn-situation-4-line-2": {
      "id": "kobenhavn-situation-4-line-2",
      "text": "Skal jeg betale, hvis jeg aflyser i dag?",
      "stamp": "2f845f6721a53022",
      "bytes": 8544,
      "at": "2026-08-27T12:24:35.413Z",
      "sourceHash": "cde40e85ab2da83ad6a64f5f220394241edb2f5396e80d04223f794acc5dcd3d"
    },
    "kobenhavn-situation-4-line-3": {
      "id": "kobenhavn-situation-4-line-3",
      "text": "Nej, ikke hvis du aflyser i dag.",
      "stamp": "00fbfbef163e34e8",
      "bytes": 8064,
      "at": "2026-08-27T12:24:35.970Z",
      "sourceHash": "48807f8f65c93de596e6181b81ab31669a5bb3a8adf19a63c0ef34b0b18c9ce8"
    },
    "kobenhavn-situation-4-line-4": {
      "id": "kobenhavn-situation-4-line-4",
      "text": "Så aflyser jeg nu.",
      "stamp": "5f3ec8d381baadd0",
      "bytes": 8256,
      "at": "2026-08-27T12:24:36.476Z",
      "sourceHash": "e6c758aaf7d7f73dbcd78d7efb49531571ab627e6c78cccd54408725304ac2b9"
    }
  },
