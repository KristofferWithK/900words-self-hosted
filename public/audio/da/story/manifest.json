{
  "entries": {
    "0-000": {
      "id": "story:0:0",
      "text": "Solen står op over Sønderborg, og en fugl synger i et stort træ.",
      "stamp": "30456b83000d83cb",
      "bytes": 16512,
      "at": "2026-08-23T00:05:54.513Z"
    },
    "0-001": {
      "id": "story:0:1",
      "text": "Huset er hvidt, og døren er rød.",
      "stamp": "eed9e749d2ff3038",
      "bytes": 9984,
      "at": "2026-08-23T00:05:55.060Z"
    },
    "0-002": {
      "id": "story:0:2",
      "text": "Der er et lille køkken med et bord, en stol og en gammel lampe.",
      "stamp": "b27443c66b54ec2b",
      "bytes": 21696,
      "at": "2026-08-23T00:05:55.801Z"
    },
    "0-003": {
      "id": "story:0:3",
      "text": "Mor laver mad, mens far drikker kaffe ved vinduet.",
      "stamp": "9c19e67f77859a27",
      "bytes": 13152,
      "at": "2026-08-23T00:05:56.403Z"
    },
    "0-004": {
      "id": "story:0:4",
      "text": "Barnet spiser et æble og drikker mælk.",
      "stamp": "5e0583b990b2b624",
      "bytes": 11424,
      "at": "2026-08-23T00:05:57.000Z"
    },
    "0-005": {
      "id": "story:0:5",
      "text": "På bordet står ost, smør, salt og et æg.",
      "stamp": "cb709d8fe5e836b9",
      "bytes": 15744,
      "at": "2026-08-23T00:05:57.626Z"
    },
    "0-006": {
      "id": "story:0:6",
      "text": "Hunden løber ud ad døren, mens en kat sover stadig på en seng.",
      "stamp": "7bac34698e41672e",
      "bytes": 18144,
      "at": "2026-08-23T00:05:58.365Z"
    },
    "0-007": {
      "id": "story:0:7",
      "text": "Deres værelse er lille, men vinduet er stort.",
      "stamp": "ae7f99b7825a4749",
      "bytes": 11136,
      "at": "2026-08-23T00:05:58.939Z"
    },
    "0-008": {
      "id": "story:0:8",
      "text": "Pigen har en blomst i hånden, og drengen har mistet en tand.",
      "stamp": "b092c42ccac61c96",
      "bytes": 14304,
      "at": "2026-08-23T00:05:59.649Z"
    },
    "0-009": {
      "id": "story:0:9",
      "text": "Hun har langt hår, en lille næse og en glad mund.",
      "stamp": "bff0bb13d43dc1b2",
      "bytes": 14496,
      "at": "2026-08-23T00:06:00.260Z"
    },
    "0-010": {
      "id": "story:0:10",
      "text": "Han lukker det ene øje og sætter en hat på hovedet.",
      "stamp": "8df39a4a7cd8c2f2",
      "bytes": 13152,
      "at": "2026-08-23T00:06:00.851Z"
    },
    "0-011": {
      "id": "story:0:11",
      "text": "Katten sidder ved hans ben, mens han har ondt i en fod.",
      "stamp": "d3872b8a3872af09",
      "bytes": 13344,
      "at": "2026-08-23T00:06:01.436Z"
    },
    "0-012": {
      "id": "story:0:12",
      "text": "Drengen har en bold under armen, og faren drikker en øl.",
      "stamp": "369614ed6babbe1b",
      "bytes": 13632,
      "at": "2026-08-23T00:06:02.035Z"
    },
    "0-013": {
      "id": "story:0:13",
      "text": "Pigen peger med en finger mod et sort fly på en klar himmel.",
      "stamp": "8ecd7d6613d33b6f",
      "bytes": 14976,
      "at": "2026-08-23T00:06:02.826Z"
    },
    "0-014": {
      "id": "story:0:14",
      "text": "Hjertet banker, fordi familien skal rejse i dag.",
      "stamp": "62bb487590225142",
      "bytes": 12864,
      "at": "2026-08-23T00:06:03.403Z"
    },
    "0-015": {
      "id": "story:0:15",
      "text": "De går ned ad en gade midt i en gammel by.",
      "stamp": "c89431bf509056fb",
      "bytes": 10464,
      "at": "2026-08-23T00:06:03.933Z"
    },
    "0-016": {
      "id": "story:0:16",
      "text": "En ung kvinde og en gammel mand venter ved en kirke.",
      "stamp": "89fb6a3b187dbfcb",
      "bytes": 14112,
      "at": "2026-08-23T00:06:04.522Z"
    },
    "0-017": {
      "id": "story:0:17",
      "text": "I en butik køber de kød, fisk og grøntsager.",
      "stamp": "fe633ad9a1d74b7a",
      "bytes": 14304,
      "at": "2026-08-23T00:06:05.125Z"
    },
    "0-018": {
      "id": "story:0:18",
      "text": "De tager også en kartoffel, sukker og en stor kage.",
      "stamp": "1b349408becb1c30",
      "bytes": 18816,
      "at": "2026-08-23T00:06:05.850Z"
    },
    "0-019": {
      "id": "story:0:19",
      "text": "Far henter penge i en bank, fordi han vil købe en bog.",
      "stamp": "678fef880bd433ac",
      "bytes": 13824,
      "at": "2026-08-23T00:06:06.459Z"
    },
    "0-020": {
      "id": "story:0:20",
      "text": "Mor arbejder på et hospital, men i dag har hun fri.",
      "stamp": "df61b74f1063b150",
      "bytes": 11904,
      "at": "2026-08-23T00:06:07.053Z"
    },
    "0-021": {
      "id": "story:0:21",
      "text": "Hendes bror er lærer på en skole.",
      "stamp": "2c95bc618131f60d",
      "bytes": 9504,
      "at": "2026-08-23T00:06:07.543Z"
    },
    "0-022": {
      "id": "story:0:22",
      "text": "Hans søster kører en rød bil, og hendes søn har en cykel.",
      "stamp": "5d50131e3591c91a",
      "bytes": 17376,
      "at": "2026-08-23T00:06:08.279Z"
    },
    "0-023": {
      "id": "story:0:23",
      "text": "En hest står i en park ved vandet.",
      "stamp": "297d2647298f6fa1",
      "bytes": 9984,
      "at": "2026-08-23T00:06:08.821Z"
    },
    "0-024": {
      "id": "story:0:24",
      "text": "Deres datter og en ven læser en bog, hvis det regner.",
      "stamp": "32581dd314cdde9d",
      "bytes": 16704,
      "at": "2026-08-23T00:06:09.477Z"
    },
    "0-025": {
      "id": "story:0:25",
      "text": "En aften i sidste uge faldt der sne over hele byen.",
      "stamp": "ac03c39afef8479c",
      "bytes": 15936,
      "at": "2026-08-23T00:06:10.127Z"
    },
    "0-026": {
      "id": "story:0:26",
      "text": "Nu venter et tog, og en bus kører forbi.",
      "stamp": "18cde00f2a092d56",
      "bytes": 10272,
      "at": "2026-08-23T00:06:10.721Z"
    },
    "0-027": {
      "id": "story:0:27",
      "text": "Fra vinduet ser de stranden og et stort hav.",
      "stamp": "17392675f311196e",
      "bytes": 13344,
      "at": "2026-08-23T00:06:11.303Z"
    },
    "0-028": {
      "id": "story:0:28",
      "text": "Det bliver nat, og man kan se månen og en klar stjerne.",
      "stamp": "204110722072e46b",
      "bytes": 16992,
      "at": "2026-08-23T00:06:11.973Z"
    },
    "0-029": {
      "id": "story:0:29",
      "text": "De elsker at rejse, selvom rejsen er lang.",
      "stamp": "cf4b20bcf5a4e26f",
      "bytes": 11904,
      "at": "2026-08-23T00:06:12.763Z"
    },
    "0-030": {
      "id": "story:0:30",
      "text": "Casey er glad, fordi kufferten er fuld af ord.",
      "stamp": "284ccf9a90abf0ac",
      "bytes": 11136,
      "at": "2026-08-23T00:06:13.319Z"
    }
  },
  "provider": "google",
